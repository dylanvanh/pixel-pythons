# Public browser configuration. Never put a private key here.
# testnet = Robinhood Testnet; sepolia = Ethereum Sepolia; local = Anvil.
VITE_NETWORK=testnet
VITE_CONTRACT_ADDRESS=
# Optional public RPC override. Any value here is visible in the browser.
VITE_RPC_URL=

# Foundry uses these only in the terminal. Do not add the VITE_ prefix.
SEPOLIA_RPC_URL=https://11155111.rpc.thirdweb.com
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
